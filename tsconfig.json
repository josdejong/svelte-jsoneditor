{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "module": "es2020",
    "lib": ["es2020", "dom"],
    "target": "es2020",
    "sourceMap": true,
    "strict": true,
    "noImplicitAny": true,
    "allowJs": false,
    "checkJs": false,
    "paths": {
      "svelte-jsoneditor": ["./src/lib"]
    }
  },
  "include": ["src/**/*.d.ts", "src/**/*.js", "src/**/*.ts", "src/**/*.svelte"]
}
